  "worldTransmutation": {
    "swaps": [
      {
        "from": "game:sand-*",
        "to": "game:gravel-*"
      },
      {
        "from": "game:gravel-*",
        "to": "game:sand-*"
      },
      {
        "from": "game:soil-*-none",
        "to": "game:soil-*-normal"
      },
      {
        "from": "game:soil-*-normal",
        "to": "game:soil-*-none"
      },
      {
