  "//litreValues": "Liquids, in EMC per litre. The game stores liquids as small portions (100 per litre for vanilla liquids), so these are divided by the liquid's itemsPerLitre: 1 L of water = 1 EMC.",
  "litreValues": {
    "game:waterportion": 1,
    "game:saltwaterportion": 1,
    "game:milkportion": 10
  },
  "//relativeValues": "Items worth a fixed fraction of another item. '*' in code is carried into 'of'. Only used for items that got no value from recipes. A metal bit is 5 of an ingot's 100 metal units.",
  "relativeValues": [
    {
      "code": "game:metalbit-*",
      "of": "game:ingot-*",
      "ratio": 0.05
    }
  ],
